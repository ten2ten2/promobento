{
  "schemaVersion": "1.0.0",
  "status": "prd_seed",
  "engine": "i18next-react-i18next",
  "defaultNamespace": "translation",
  "resourceFormat": "nested_module_keys",
  "defaultUiLocale": "en",
  "fallbackUiLocale": "en",
  "supportedUiLocales": ["en"],
  "defaultVideoLanguage": "en",
  "supportedVideoLanguages": ["en"],
  "videoLanguageField": "language",
  "defaultFormattingLocale": "en-US",
  "defaultSsrTimeZone": "UTC",
  "billingCurrency": "USD",
  "uiLanguages": {
    "en": {
      "label": "English",
      "direction": "ltr",
      "formattingLocale": "en-US",
      "resourceFile": "locales/en.json"
    }
  },
  "videoLanguages": {
    "en": {
      "label": "English",
      "direction": "ltr",
      "fontCoverageValidationRequired": true
    }
  },
  "selection": {
    "showUiLanguageSwitcher": false,
    "showVideoLanguageSelector": false,
    "showVideoLanguageInfo": true
  },
  "routing": {
    "defaultLocalePrefix": "",
    "publishAlternateLocales": false,
    "redirectByAcceptLanguage": false,
    "emitHreflangForUnpublishedLocales": false,
    "publishPseudoLocale": false
  },
  "validation": {
    "unsupportedUiLocaleCode": "UNSUPPORTED_UI_LOCALE",
    "unsupportedVideoLanguageCode": "UNSUPPORTED_VIDEO_LANGUAGE",
    "httpStatus": 422,
    "chargeCreditsOnRejection": false,
    "allowUnicodeCustomerNames": true,
    "translateCustomerFactsAutomatically": false
  }
}
