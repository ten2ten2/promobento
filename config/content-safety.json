{
  "schemaVersion": "3.0.0",
  "policyVersion": "prompt-sift-v3",
  "enabled": false,
  "status": "reference_only_production_wiring_pending",
  "operatorControl": "server_only",
  "provider": "waffo_prompt_sift",
  "api": {
    "method": "POST",
    "path": "/v1/actions/verification/scan-prompt",
    "credentialSource": "existing_trusted_waffo_client",
    "browserReceivesCredentials": false,
    "sdkReturns": "unwrapped_verdict"
  },
  "appliesTo": [
    "creative_generate",
    "agent_patch",
    "prepare_targets"
  ],
  "trigger": "before_each_actual_generation_with_new_content",
  "deterministicRenderingRequiresNewScan": false,
  "promptAssembly": "canonical_json_task_instruction_facts_transcript_comments_editableTexts",
  "oversizedInput": "reject_and_request_shorter_input",
  "disabledResult": "provider_disabled_not_a_safety_approval",
  "scanAutosaveOrKeystrokes": false,
  "semantic": "enforce",
  "maxPromptCharacters": 10000,
  "inputBudgetScope": "selected_generation_context",
  "lengthUnit": "unicode_code_points",
  "lengthUnitAuthority": "local_input_policy",
  "providerCharacterBoundary": "integration_verification_pending",
  "truncatePrompt": false,
  "normalizePrompt": false,
  "locales": [
    "en",
    "zh",
    "ja"
  ],
  "timeoutMs": 10000,
  "allowRequiresSemanticStatus": "scored",
  "retry": {
    "serverErrorInitialDelayMs": 5000,
    "maxServerErrorRetries": 3,
    "rateLimitUsesRetryAfter": true,
    "retryOtherClientErrors": false,
    "schedulingOnly": true
  },
  "audit": {
    "storeRawPrompt": false,
    "storeRawProviderResponse": false,
    "storeRawErrorMessage": false,
    "receiptBindsExactPromptAndGeneration": true,
    "cacheEnabled": false
  },
  "pricing": {
    "observedStatus": "beta_free",
    "permanentFreeAssumption": false,
    "actualUsageStillMetered": true
  },
  "source": "https://docs.waffo.ai/zh/api-reference/endpoints/content-safety/scan-prompt",
  "checkedAt": "2026-10-21",
  "preflightBeforeQuotaReservation": true
}
