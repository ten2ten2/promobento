{
  "schemaVersion": "3.0.0",
  "policyVersion": "preview-v3",
  "status": "planned_not_deployed",
  "localPlayback": {
    "mode": "local_full",
    "bridgeMode": "local_preview",
    "pixelScale": 0.5,
    "logicalDimensionsSource": "config/platform-presets.json",
    "durationSource": "composition.totalFrames / 30",
    "audioSource": "session_task_scoped_mixedAudioUrl_with_mixedAudioHash",
    "audioOwner": "studio_parent",
    "playbackClock": "audio_currentTime_or_parent_monotonic_clock_when_silent",
    "frameScheduling": "one_seek_in_flight_coalesce_to_latest_clock_frame",
    "autoplayBlocked": "pause_until_user_play_action",
    "valuesSourcePath": "values.json",
    "unsavedValues": "validated_local_overlay",
    "responseOrdering": "requestedEpoch_ack_then_appliedEpoch_and_request_sequence",
    "commandScheduling": "serialize_init_set_values_seek_inspect",
    "rejectedValues": "preserve_applied_epoch_and_preparation",
    "savedRevisionSwitch": "new_session_ready_then_swap_without_blanking",
    "commentsRequire": "saved_revision_matching_displayed_values",
    "sessionExpiry": "create_replacement_before_expiry_recheck_current_access",
    "sharedEditables": "same_declarations_for_every_target",
    "inspectOverlaps": "last_declared_containing_region_wins",
    "inspectBoundary": "right_or_bottom_edge_has_no_hit",
    "logicalLayout": "fixed_target_css_dimensions",
    "domDisplayScale": "host_transform_with_inverse_pointer_mapping",
    "canvasBufferScale": "explicit_pixelScale",
    "ambientDevicePixelRatioAffectsContent": false,
    "sampling": "nominal_single_sample",
    "frameEvent": "preview-frame-ready",
    "motionProfilePlaybackIsApproximate": true,
    "grantsRendererSamplePermission": false,
    "editOrReplayStartsCloudQa": false,
    "editOrReplayStartsVideoEncoding": false
  },
  "trustedCapture": {
    "enabled": false,
    "pixelScale": 1,
    "devicePixelRatio": 1,
    "formats": ["screenshot", "clip"],
    "requiresExplicitIntent": true,
    "budgeted": true,
    "limits": {
      "maxClipFrames": null,
      "maxRequestsPerProjectWindow": null,
      "maxClipFramesPerProjectWindow": null,
      "maxRequestsPerTrial": null,
      "maxClipFramesPerTrial": null
    },
    "projectWindowSource": "config/agent-policy.json#cost.usageWindowHours",
    "trialScope": "original_trial_claim",
    "countersInclude": "started_requests_and_active_reservations",
    "unmeasuredLimits": "keep_capture_disabled",
    "reservation": "atomic_with_cost_budget_and_idempotency_key"
  },
  "brandWatermark": {
    "source": "config/brand.json#publicPreviewWatermark",
    "owner": "studio_parent_outside_composition_iframe",
    "placement": "preview_footer_band",
    "overlapsComposition": false,
    "includedInPreviewCapture": true,
    "encodedPreviewOwner": "trusted_capture_compositor",
    "includedInContentQa": false,
    "includedInPaidExport": false
  },
  "aiMarking": {
    "source": "trusted_marking_profile",
    "independentOfBrandWatermark": true,
    "captureEvidenceBindsActualBytes": true,
    "localPlaybackIsNotEncodedArtifactEvidence": true
  },
  "isolation": {
    "previewOrigin": "https://p.promobentousercontent.com",
    "stagingPreviewOrigin": "https://staging-p.promobentousercontent.com",
    "previewRegistrableDomain": "promobentousercontent.com",
    "deploymentGate": "S2",
    "status": "origin_and_sandbox_not_verified",
    "separateFromAppOrigin": true,
    "taskScoped": true,
    "sessionTtlSeconds": 900,
    "allowMainSiteCookies": false,
    "drmGuarantee": false
  }
}
