{
  "schemaVersion": "1.1.0",
  "status": "design_spec_seed_requires_browser_validation",
  "defaultPreference": "system",
  "preferences": ["system", "light", "dark"],
  "htmlAttribute": "data-theme",
  "cssVariablePrefix": "--ui-",
  "videoCssVariablePrefix": "--video-",
  "systemResolution": "css_prefers_color_scheme",
  "persistence": {
    "kind": "server_set_cookie",
    "name": "promobento_theme",
    "maxAgeSeconds": 31536000,
    "path": "/",
    "sameSite": "Lax",
    "secureInProduction": true,
    "httpOnly": true,
    "hostOnly": true
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "colors": {
        "bg": "#F8FAFC",
        "surface": "#FFFFFF",
        "surfaceRaised": "#FFFFFF",
        "surfaceMuted": "#F1F5F9",
        "text": "#0F172A",
        "textMuted": "#475569",
        "border": "#CBD5E1",
        "borderControl": "#64748B",
        "primary": "#6D28D9",
        "primaryText": "#FFFFFF",
        "primaryHover": "#5B21B6",
        "primaryActive": "#4C1D95",
        "surfaceHover": "#F1F5F9",
        "surfaceActive": "#E2E8F0",
        "link": "#6D28D9",
        "focus": "#6D28D9",
        "danger": "#B91C1C",
        "dangerText": "#FFFFFF",
        "dangerHover": "#991B1B",
        "dangerActive": "#7F1D1D",
        "dangerBg": "#FEF2F2",
        "success": "#166534",
        "successBg": "#F0FDF4",
        "warning": "#92400E",
        "warningBg": "#FFFBEB",
        "info": "#1D4ED8",
        "infoBg": "#EFF6FF",
        "selection": "#EDE9FE",
        "selectionText": "#4C1D95",
        "disabled": "#E2E8F0",
        "disabledText": "#64748B"
      }
    },
    "dark": {
      "colorScheme": "dark",
      "colors": {
        "bg": "#0B1020",
        "surface": "#151D2F",
        "surfaceRaised": "#202B40",
        "surfaceMuted": "#263247",
        "text": "#F8FAFC",
        "textMuted": "#CBD5E1",
        "border": "#38455B",
        "borderControl": "#94A3B8",
        "primary": "#C4B5FD",
        "primaryText": "#1E1B4B",
        "primaryHover": "#DDD6FE",
        "primaryActive": "#A78BFA",
        "surfaceHover": "#202B40",
        "surfaceActive": "#263247",
        "link": "#C4B5FD",
        "focus": "#C4B5FD",
        "danger": "#FCA5A5",
        "dangerText": "#450A0A",
        "dangerHover": "#FECACA",
        "dangerActive": "#F87171",
        "dangerBg": "#3F1D2A",
        "success": "#86EFAC",
        "successBg": "#12352C",
        "warning": "#FCD34D",
        "warningBg": "#3D2E18",
        "info": "#93C5FD",
        "infoBg": "#172C4A",
        "selection": "#4C1D95",
        "selectionText": "#F5F3FF",
        "disabled": "#334155",
        "disabledText": "#94A3B8"
      }
    }
  },
  "contrastRules": [
    {"foreground": "text", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "textMuted", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "link", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "primaryText", "backgrounds": ["primary", "primaryHover", "primaryActive"], "minimum": 4.5},
    {"foreground": "dangerText", "backgrounds": ["danger", "dangerHover", "dangerActive"], "minimum": 4.5},
    {"foreground": "text", "backgrounds": ["surfaceHover", "surfaceActive"], "minimum": 4.5},
    {"foreground": "textMuted", "backgrounds": ["surfaceHover", "surfaceActive"], "minimum": 4.5},
    {"foreground": "danger", "backgrounds": ["dangerBg"], "minimum": 4.5},
    {"foreground": "success", "backgrounds": ["successBg"], "minimum": 4.5},
    {"foreground": "warning", "backgrounds": ["warningBg"], "minimum": 4.5},
    {"foreground": "info", "backgrounds": ["infoBg"], "minimum": 4.5},
    {"foreground": "danger", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "success", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "warning", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "selectionText", "backgrounds": ["selection"], "minimum": 4.5},
    {"foreground": "borderControl", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 3.0},
    {"foreground": "focus", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 3.0}
  ]
}
