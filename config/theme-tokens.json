{
  "schemaVersion": "1.4.0",
  "status": "design_spec_seed_requires_browser_validation",
  "defaultPreference": "system",
  "preferences": ["system", "light", "dark"],
  "htmlAttribute": "data-theme",
  "cssVariablePrefix": "--ui-",
  "videoCssVariablePrefix": "--video-",
  "systemResolution": "css_prefers_color_scheme",
  "interaction": {
    "control": "icon_button",
    "toggleFrom": "resolvedTheme",
    "light": {"icon": "moon", "labelKey": "common.switchToDarkMode", "nextPreference": "dark"},
    "dark": {"icon": "sun", "labelKey": "common.switchToLightMode", "nextPreference": "light"},
    "systemResetLabelKey": "settings.useDeviceSetting"
  },
  "persistence": {
    "kind": "server_set_cookie",
    "name": "promobento_theme",
    "maxAgeSeconds": 31536000,
    "path": "/",
    "sameSite": "Lax",
    "secureInProduction": true,
    "httpOnly": true,
    "hostOnly": true,
    "onlyOnUserAction": true,
    "writeStrategy": "serial_coalesce_latest"
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "colors": {
        "bg": "#FFFFFF",
        "surface": "#FAF7F3",
        "surfaceRaised": "#FFFFFF",
        "surfaceMuted": "#F3EEE9",
        "text": "#2A2420",
        "textMuted": "#6F6560",
        "border": "#E6E0DA",
        "borderControl": "#8C817A",
        "primary": "#4A3B35",
        "primaryText": "#FFFFFF",
        "primaryHover": "#3B2E29",
        "primaryActive": "#2E2420",
        "surfaceHover": "#F5F1ED",
        "surfaceActive": "#EEE7E0",
        "link": "#9F511A",
        "focus": "#9F511A",
        "danger": "#A33838",
        "dangerText": "#FFFFFF",
        "dangerHover": "#8F2C2C",
        "dangerActive": "#7E2323",
        "dangerBg": "#F8EEEE",
        "success": "#336647",
        "successBg": "#EFF4F1",
        "warning": "#805D27",
        "warningBg": "#F7F2E8",
        "info": "#355C7E",
        "infoBg": "#EEF2F6",
        "selection": "#FBE3CC",
        "selectionText": "#2A2420",
        "disabled": "#EEE9E4",
        "disabledText": "#857A73",
        "accent": "#F0A868",
        "accentText": "#9F511A",
        "onAccent": "#2A2420",
        "accentStrong": "#C8681F",
        "stage": "#E8E8E8",
        "timelineTrack": "#EEEEEE",
        "timelineTrackSelected": "#E6E6E6"
      }
    },
    "dark": {
      "colorScheme": "dark",
      "colors": {
        "bg": "#171412",
        "surface": "#211C19",
        "surfaceRaised": "#2A2420",
        "surfaceMuted": "#262019",
        "text": "#EFE9E4",
        "textMuted": "#B3A89F",
        "border": "#3A322D",
        "borderControl": "#8A7E75",
        "primary": "#F3E6D8",
        "primaryText": "#2A2420",
        "primaryHover": "#FAF0E6",
        "primaryActive": "#E6D6C5",
        "surfaceHover": "#2C2622",
        "surfaceActive": "#3A2E26",
        "link": "#F4B37A",
        "focus": "#F4B37A",
        "danger": "#E6AAAA",
        "dangerText": "#371B1B",
        "dangerHover": "#F0BBBB",
        "dangerActive": "#DA9595",
        "dangerBg": "#35282A",
        "success": "#9BC3AC",
        "successBg": "#24322B",
        "warning": "#D7BD8E",
        "warningBg": "#343024",
        "info": "#AAC5DF",
        "infoBg": "#273340",
        "selection": "#4A3426",
        "selectionText": "#EFE9E4",
        "disabled": "#332C28",
        "disabledText": "#8A7E75",
        "accent": "#F0A868",
        "accentText": "#F4B37A",
        "onAccent": "#2A2420",
        "accentStrong": "#F0A868",
        "stage": "#0E0E0E",
        "timelineTrack": "#242424",
        "timelineTrackSelected": "#343434"
      }
    }
  },
  "contrastRules": [
    {"foreground": "text", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 4.5},
    {"foreground": "textMuted", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 4.5},
    {"foreground": "link", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 4.5},
    {"foreground": "primaryText", "backgrounds": ["primary", "primaryHover", "primaryActive"], "minimum": 4.5},
    {"foreground": "dangerText", "backgrounds": ["danger", "dangerHover", "dangerActive"], "minimum": 4.5},
    {"foreground": "text", "backgrounds": ["surfaceHover", "surfaceActive"], "minimum": 4.5},
    {"foreground": "textMuted", "backgrounds": ["surfaceHover", "surfaceActive"], "minimum": 4.5},
    {"foreground": "danger", "backgrounds": ["dangerBg"], "minimum": 4.5},
    {"foreground": "success", "backgrounds": ["successBg"], "minimum": 4.5},
    {"foreground": "warning", "backgrounds": ["warningBg"], "minimum": 4.5},
    {"foreground": "info", "backgrounds": ["infoBg"], "minimum": 4.5},
    {"foreground": "danger", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "success", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "warning", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted"], "minimum": 4.5},
    {"foreground": "selectionText", "backgrounds": ["selection"], "minimum": 4.5},
    {"foreground": "borderControl", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 3.0},
    {"foreground": "focus", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 3.0},
    {"foreground": "accentText", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "stage", "timelineTrack", "timelineTrackSelected"], "minimum": 4.5},
    {"foreground": "onAccent", "backgrounds": ["accent"], "minimum": 4.5},
    {"foreground": "accentStrong", "backgrounds": ["bg", "surface", "surfaceRaised", "surfaceMuted", "timelineTrack", "timelineTrackSelected", "stage"], "minimum": 3.0}
  ]
}
