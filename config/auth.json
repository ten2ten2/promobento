{
  "schemaVersion": "1.0.0",
  "status": "prd_seed",
  "sourceDocument": "docs/prd/12-routing-and-auth.md",
  "routeSource": "config/routes.json",
  "methods": ["google", "email_otp"],
  "passwordAuthentication": false,
  "magicLinkAuthentication": false,
  "routes": {
    "login": "auth.login",
    "verify": "auth.verify",
    "link": "auth.link",
    "googleStart": "auth.google.start",
    "googleCallback": "auth.google.callback",
    "emailRequest": "auth.email.request",
    "emailVerify": "auth.email.verify",
    "emailResend": "auth.email.resend",
    "session": "auth.session",
    "logout": "auth.logout",
    "linkConfirm": "auth.links.confirm",
    "registrationConfirm": "auth.registrations.confirm",
    "cancelFlow": "auth.flow.cancel"
  },
  "google": {
    "scopes": ["openid", "email", "profile"],
    "pkceMethod": "S256",
    "identityKey": "verified_issuer_and_sub",
    "automaticLinkByEmail": false,
    "unknownIdentity": "confirm_create_or_link"
  },
  "email": {
    "transport": "cloudflare_email_service",
    "bindingName": "EMAIL",
    "providerStatusAtReview": "beta",
    "reviewedAt": "2026-10-19",
    "requiresWorkersPaid": true,
    "requiresVerifiedSendingDomain": true,
    "messageLocaleSource": "website_ui_locale",
    "defaultMessageLocale": "en",
    "production": {
      "fromName": "PromoBento",
      "fromAddress": "login@auth.promobento.com",
      "replyTo": "support@promobento.com",
      "verificationStatus": "pending"
    },
    "staging": {
      "fromName": "PromoBento Preview",
      "fromAddress": "login@auth-staging.promobento.com",
      "replyTo": "support@promobento.com",
      "verificationStatus": "pending",
      "controlledRecipientsOnly": true
    },
    "localAndCiTransport": "mock",
    "comparison": {
      "trimOuterWhitespace": true,
      "domain": "idna_ascii_lowercase",
      "localPart": "case_sensitive",
      "stripDots": false,
      "stripPlusTags": false,
      "unicodeLocalPart": "requires_transport_acceptance_before_enablement"
    },
    "otp": {
      "digits": 6,
      "expiresAfterSeconds": 600,
      "resendAfterSeconds": 60,
      "maxFailedAttemptsPerFlow": 5,
      "maxSendsPerFlow": 5,
      "resendResetsFailedAttempts": false,
      "resendInvalidationScope": "current_flow",
      "digest": "HMAC-SHA-256",
      "secretBindingName": "AUTH_OTP_SECRET",
      "storePlaintext": false
    },
    "sendLimits": {
      "perEmailHour": 5,
      "perEmailDay": 20,
      "perIp15Minutes": 30,
      "globalDailyBudget": "set_from_verified_account_quota_before_release",
      "blocksExistingCodeVerification": false
    },
    "messageKeys": {
      "subject": "authEmail.subject",
      "preheader": "authEmail.preheader",
      "heading": "authEmail.heading",
      "codeBody": "authEmail.codeBody",
      "linkSubject": "authEmail.linkSubject",
      "linkPreheader": "authEmail.linkPreheader",
      "linkHeading": "authEmail.linkHeading",
      "linkCodeBody": "authEmail.linkCodeBody",
      "expiry": "authEmail.expiry",
      "ignoreIfUnrequested": "authEmail.ignoreIfUnrequested",
      "support": "authEmail.support"
    }
  },
  "flow": {
    "initialPurposes": ["login", "link", "reauth"],
    "pendingLoginResolutions": ["register", "link"],
    "reauthActions": ["logout_all", "delete_workspace", "transfer_owner", "account_close"],
    "reauthBoundToActionIntent": true,
    "expiresAfterSeconds": 1800,
    "randomBytes": 32,
    "proofExpiresAfterSeconds": 600,
    "cookie": {
      "name": "__Host-promobento_auth_flow",
      "httpOnly": true,
      "secure": true,
      "sameSite": "Lax",
      "path": "/",
      "hostOnly": true
    },
    "returnTo": {
      "defaultPath": "/app/projects",
      "maxLength": 2048,
      "allowedPageGroups": ["create", "app", "invite"],
      "relativePathsOnly": true,
      "allowFragment": false,
      "storedServerSide": true
    }
  },
  "session": {
    "randomBytes": 32,
    "storage": "token_hash_only",
    "absoluteExpiresAfterSeconds": 2592000,
    "slidingExpiration": false,
    "logoutScopes": ["current", "all"],
    "defaultLogoutScope": "current",
    "cookie": {
      "name": "__Host-promobento_session",
      "httpOnly": true,
      "secure": true,
      "sameSite": "Lax",
      "path": "/",
      "hostOnly": true
    },
    "clearThemeCookieOnLogout": false
  },
  "accountLinking": {
    "existingMethodProofRequired": true,
    "newMethodProofRequired": true,
    "explicitConfirmationRequired": true,
    "automaticAccountMerge": false,
    "allowIdentityTransfer": false,
    "separateRegistrationRequiresConfirmation": true,
    "selfServiceUnlink": false
  },
  "errorMessageKeys": {
    "INVALID_EMAIL": "auth.invalidEmail",
    "AUTH_RATE_LIMITED": "auth.tooManyRequests",
    "AUTH_CODE_INVALID_OR_EXPIRED": "auth.codeInvalidOrExpired",
    "AUTH_ATTEMPTS_EXCEEDED": "auth.codeAttemptsExceeded",
    "AUTH_FLOW_EXPIRED": "auth.flowExpired",
    "AUTH_RESTART_REQUIRED": "auth.restartRequired",
    "AUTH_EMAIL_UNAVAILABLE": "auth.emailUnavailable",
    "AUTH_LINK_CONFLICT": "auth.linkConflict",
    "AUTH_REAUTH_REQUIRED": "auth.confirmExistingMethod"
  }
}
