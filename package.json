{
  "name": "promobento",
  "version": "0.0.0",
  "private": true,
  "description": "PromoBento current PRD, contracts and repository tooling; application implementation starts at M0.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "check:contracts": "node scripts/check-production-contracts.mjs",
    "test:contracts": "node --test scripts/*.test.mjs packages/contracts/test/*.test.mjs",
    "build:agent-reference": "node scripts/build-agent-reference.mjs",
    "check:agent-reference": "node scripts/check-agent-reference.mjs"
  },
  "devDependencies": {
    "@promobento/contracts": "workspace:*"
  }
}
