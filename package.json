{
  "name": "promobento",
  "version": "0.0.0",
  "private": true,
  "description": "PromoBento contracts, repository checks and the M0a local rendering implementation.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "check:contracts": "node scripts/check-production-contracts.mjs",
    "test": "node scripts/run-tests.mjs",
    "build:agent-reference": "node scripts/build-agent-reference.mjs",
    "check:agent-reference": "node scripts/check-agent-reference.mjs",
    "install:renderer": "node apps/renderer/scripts/install-browser.mjs",
    "render:fixture": "node apps/renderer/scripts/render-fixture.mjs",
    "test:render": "node scripts/run-tests.mjs --render",
    "build:admission": "node apps/renderer/scripts/build-admission.mjs",
    "render:admission": "node apps/renderer/scripts/render-admission.mjs",
    "test:admission": "node apps/renderer/scripts/test-admission.mjs",
    "agent:local": "node apps/agent-runner/scripts/local-agent.mjs",
    "test:admission-media": "node apps/renderer/scripts/test-admission-media.mjs",
    "benchmark:m0a": "node scripts/benchmark-m0a.mjs"
  },
  "devDependencies": {
    "@promobento/contracts": "workspace:*"
  }
}
