// Internal S1 runs only in staging. Deploy/build through GitHub Actions; production execution remains off.
{
  "name": "promobento",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "promobento-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "promobento-staging",
          "database_id": "e621c179-dcb0-4f20-b5a3-236ba92e5580",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "promobento-staging-media"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX",
            "queue": "promobento-staging-outbox"
          }
        ],
        "consumers": [
          {
            "queue": "promobento-staging-outbox",
            "max_batch_size": 5,
            "max_retries": 10
          }
        ]
      },
      "vars": {
        "S1_ENABLED": "internal_eval"
      },
      "workers_dev": true,
      "containers": [
        {
          "name": "promobento-staging-render",
          "class_name": "ShardDO",
          "scheduling_policy": "durable_object",
          "images": {
            "render": {
              "dockerfile": "../render-container/Dockerfile",
              "build_context": "../.."
            }
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SHARDS",
            "class_name": "ShardDO"
          },
          {
            "name": "COORDINATOR",
            "class_name": "CoordinatorDO"
          },
          {
            "name": "OPERATIONS",
            "class_name": "OperationDO"
          }
        ]
      },
      "workflows": [
        {
          "name": "promobento-staging-render",
          "binding": "RENDER_WORKFLOW",
          "class_name": "RenderWorkflow"
        },
        {
          "name": "promobento-staging-operation",
          "binding": "OPERATION_WORKFLOW",
          "class_name": "OperationWorkflow"
        }
      ]
    },
    "production": {
      "name": "promobento-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "promobento-prod",
          "database_id": "f227aaf6-6fde-4a1a-ade2-2480bd0b381f",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "promobento-prod-media"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX",
            "queue": "promobento-prod-outbox"
          }
        ]
      },
      "vars": {
        "S1_ENABLED": "off"
      }
    }
  },
  "migrations": [
    {
      "tag": "s1-v1",
      "new_sqlite_classes": [
        "ShardDO",
        "CoordinatorDO",
        "OperationDO"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  }
}
