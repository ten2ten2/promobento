{
  "name": "@promobento/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./canonical": {
      "types": "./src/canonical.d.mts",
      "default": "./src/canonical.mjs"
    },
    "./validators/*": {
      "types": "./generated/*.d.mts",
      "default": "./generated/*.mjs"
    },
    "./validation": {
      "types": "./src/validation.d.mts",
      "default": "./src/validation.mjs"
    },
    "./film": {
      "types": "./src/film.d.mts",
      "default": "./src/film.mjs"
    },
    "./random": {
      "types": "./src/random.d.mts",
      "default": "./src/random.mjs"
    },
    "./digest": {
      "types": "./src/digest.d.mts",
      "default": "./src/digest.mjs"
    },
    "./identity": "./src/identity.mjs",
    "./render": {
      "types": "./src/render.d.mts",
      "default": "./src/render.mjs"
    },
    "./seams": {
      "types": "./src/seams.d.mts",
      "default": "./src/seams.mjs"
    },
    "./film-source": {
      "types": "./src/film-source.d.mts",
      "default": "./src/film-source.mjs"
    },
    "./film-composition": {
      "types": "./src/film-composition.d.mts",
      "default": "./src/film-composition.mjs"
    },
    "./video-frames": {
      "types": "./src/video-frames.d.mts",
      "default": "./src/video-frames.mjs"
    },
    "./custom-source": {
      "types": "./src/custom-source.d.mts",
      "default": "./src/custom-source.mjs"
    }
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
