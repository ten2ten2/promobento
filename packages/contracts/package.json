{
  "name": "@promobento/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./canonical": {
      "types": "./src/canonical.d.mts",
      "default": "./src/canonical.mjs"
    },
    "./validators/*": {
      "types": "./generated/*.d.mts",
      "default": "./generated/*.mjs"
    },
    "./validation": {
      "types": "./src/validation.d.mts",
      "default": "./src/validation.mjs"
    },
    "./digest": {
      "types": "./src/digest.d.mts",
      "default": "./src/digest.mjs"
    },
    "./targets": "./src/targets.mjs",
    "./video-frames": {
      "types": "./src/video-frames.d.mts",
      "default": "./src/video-frames.mjs"
    },
    "./native-project": {
      "types": "./src/native-project.d.mts",
      "default": "./src/native-project.mjs"
    },
    "./png": {
      "types": "./src/png.d.mts",
      "default": "./src/png.mjs"
    }
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
