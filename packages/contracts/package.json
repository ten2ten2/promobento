{
  "name": "@promobento/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./canonical": {
      "types": "./src/canonical.d.mts",
      "default": "./src/canonical.mjs"
    },
    "./validators/*": {
      "types": "./generated/*.d.mts",
      "default": "./generated/*.mjs"
    },
    "./validation": { "types": "./src/validation.d.mts", "default": "./src/validation.mjs" },
    "./film": { "types": "./src/film.d.mts", "default": "./src/film.mjs" },
    "./random": { "types": "./src/random.d.mts", "default": "./src/random.mjs" },
    "./digest": { "types": "./src/digest.d.mts", "default": "./src/digest.mjs" },
    "./identity": "./src/identity.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
