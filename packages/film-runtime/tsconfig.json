{
  "compilerOptions": {
    "target": "es2024", "module": "esnext", "moduleResolution": "bundler", "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "isolatedModules": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "types": []
  },
  "include": ["src/**/*.ts", "../blocks/src/**/*.ts"]
}
