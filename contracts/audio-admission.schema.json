{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://promobento.com/contracts/audio-admission/3.0.0",
  "title":"Trusted internal music admission",
  "oneOf":[{"$ref":"#/$defs/catalog"},{"$ref":"#/$defs/evidence"}],
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "resourceId":{"type":"string","pattern":"^res_[A-Za-z0-9_-]{4,64}$"},
    "catalog":{
      "type":"object","additionalProperties":false,"required":["kind","sources"],
      "properties":{
        "kind":{"const":"audio_source_catalog"},
        "sources":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/source"}}
      }
    },
    "source":{
      "type":"object","additionalProperties":false,"required":["kind","resourceId","sha256","key","byteLength"],
      "properties":{
        "kind":{"enum":["score","upload"]},
        "resourceId":{"$ref":"#/$defs/resourceId"},
        "sha256":{"$ref":"#/$defs/hash"},
        "key":{"type":"string","pattern":"^evals/[A-Za-z0-9_/-]{4,240}\\.[a-z0-9]{2,8}$"},
        "byteLength":{"type":"integer","minimum":1,"maximum":8388608},
        "scoreRef":{"type":"string","pattern":"^scenes/[a-z][a-z0-9-]{0,47}/[A-Za-z0-9._-]{1,64}\\.abc$|^audio/[A-Za-z0-9._-]{1,64}\\.abc$"}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"const":"score"}},"required":["kind"]},"then":{"required":["scoreRef"],"properties":{"scoreRef":{},"byteLength":{"type":"integer","maximum":16384}}},"else":{"properties":{"scoreRef":false}}}
      ]
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["kind","operationId","resourceId","sha256","licenseRef","scope","approvedBy","source","basis"],
      "properties":{
        "kind":{"const":"audio_source_rights"},
        "operationId":{"type":"string","pattern":"^[A-Za-z0-9_-]{4,96}$"},
        "resourceId":{"$ref":"#/$defs/resourceId"},"sha256":{"$ref":"#/$defs/hash"},
        "licenseRef":{"type":"string","minLength":1,"maxLength":120},
        "scope":{"const":"internal_eval_only"},"approvedBy":{"const":"owner"},
        "source":{"type":"string","minLength":1,"maxLength":2048},"basis":{"type":"string","minLength":1,"maxLength":8000},
        "scoreApprovals":{
          "type":"array","minItems":1,"maxItems":2,
          "items":{"type":"object","additionalProperties":false,"required":["requestHash","totalFrames"],
            "properties":{"requestHash":{"$ref":"#/$defs/hash"},"totalFrames":{"enum":[450,900]}}}
        }
      }
    }
  }
}
