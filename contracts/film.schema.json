{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/film/3.0.0",
  "title": "FilmSpec (film-v1)",
  "description": "The trusted data layer of a film: style tokens, audio choice, text slots bound to facts, asset slots and scenes. Cross-field rules (coverage, references, fact binding) live in packages/contracts/src/film.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specVersion", "audience", "durationSeconds", "fps", "totalFrames", "style", "audio", "texts", "assets", "scenes", "treatment"],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "specVersion": {"const": "film-v1"},
    "audience": {"enum": ["software", "course"]},
    "durationSeconds": {"enum": [15, 30]},
    "fps": {"const": 30},
    "totalFrames": {"enum": [450, 900]},
    "style": {"$ref": "#/$defs/style"},
    "audio": {"$ref": "#/$defs/audio"},
    "texts": {
      "type": "object", "maxProperties": 200,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/textSlot"}
    },
    "assets": {
      "type": "object", "maxProperties": 100,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/assetSlot"}
    },
    "scenes": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"$ref": "#/$defs/scene"}},
    "treatment": {"$ref": "#/$defs/treatment"}
  },
  "allOf": [
    {
      "if": {"type": "object", "properties": {"durationSeconds": {"const": 15}}, "required": ["durationSeconds"]},
      "then": {"type": "object", "properties": {"totalFrames": {"const": 450}}},
      "else": {"type": "object", "properties": {"totalFrames": {"const": 900}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "frame": {"type": "integer", "minimum": 0, "maximum": 900},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 200},
    "fontRef": {
      "type": "object", "additionalProperties": false, "required": ["fontId", "weight"],
      "properties": {
        "fontId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "weight": {"type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100},
        "style": {"enum": ["normal", "italic"]}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false, "required": ["palette", "type", "motion"],
      "properties": {
        "palette": {
          "type": "object", "additionalProperties": false, "required": ["roles", "sources"],
          "properties": {
            "roles": {
              "type": "object", "maxProperties": 16, "required": ["bg", "ink", "accent"],
              "properties": {"bg": {"$ref": "#/$defs/color"}, "ink": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}},
              "propertyNames": {"$ref": "#/$defs/id"},
              "additionalProperties": {"$ref": "#/$defs/color"}
            },
            "sources": {
              "description": "Where each role's colour came from, e.g. brand, asset:<key>, direction.",
              "type": "object", "maxProperties": 16,
              "propertyNames": {"$ref": "#/$defs/id"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          }
        },
        "type": {
          "type": "object", "additionalProperties": false, "required": ["display", "text", "scale"],
          "properties": {
            "display": {"$ref": "#/$defs/fontRef"},
            "text": {"$ref": "#/$defs/fontRef"},
            "mono": {"$ref": "#/$defs/fontRef"},
            "scale": {"enum": ["compact", "regular", "large"]}
          }
        },
        "motion": {
          "type": "object", "additionalProperties": false, "required": ["language", "energy", "easing", "transitions"],
          "properties": {
            "language": {"$ref": "#/$defs/id"},
            "energy": {"type": "integer", "minimum": 1, "maximum": 5},
            "easing": {"$ref": "#/$defs/id"},
            "transitions": {"$ref": "#/$defs/id"}
          }
        },
        "texture": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": {"enum": ["none", "grain", "paper", "glow"]},
            "amount": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["music", "sfx", "captions"],
      "properties": {
        "music": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind", "style"],
              "properties": {"kind": {"const": "procedural"}, "style": {"$ref": "#/$defs/id"}, "bpm": {"type": "integer", "minimum": 60, "maximum": 180}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "scoreRef"],
              "properties": {"kind": {"const": "score"}, "scoreRef": {"type": "string", "pattern": "^scenes/[a-z][a-z0-9-]{0,47}/[A-Za-z0-9._-]{1,64}\\.abc$|^audio/[A-Za-z0-9._-]{1,64}\\.abc$"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "resourceId"],
              "properties": {"kind": {"const": "upload"}, "resourceId": {"type": "string", "pattern": "^res_[A-Za-z0-9_-]{4,64}$"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": {"kind": {"const": "none"}}}
          ]
        },
        "voice": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["resourceId", "transcriptId"],
              "properties": {"resourceId": {"type": "string", "pattern": "^res_[A-Za-z0-9_-]{4,64}$"}, "transcriptId": {"type": "string", "minLength": 1, "maxLength": 80}}},
            {"type": "object", "additionalProperties": false, "required": ["tts"],
              "properties": {"tts": {"type": "object", "additionalProperties": false, "required": ["voiceId", "transcriptId"],
                "properties": {"voiceId": {"type": "string", "minLength": 1, "maxLength": 80}, "transcriptId": {"type": "string", "minLength": 1, "maxLength": 80}}}}}
          ]
        },
        "sfx": {
          "oneOf": [
            {"const": "auto"},
            {"type": "array", "maxItems": 120, "items": {"$ref": "#/$defs/sfxEvent"}}
          ]
        },
        "captions": {"enum": ["auto", "off"]},
        "mute": {"type": "boolean"}
      }
    },
    "sfxEvent": {
      "type": "object", "additionalProperties": false, "required": ["at", "id"],
      "properties": {
        "at": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["sceneId", "event"],
              "properties": {"sceneId": {"$ref": "#/$defs/id"}, "event": {"$ref": "#/$defs/id"}}},
            {"type": "object", "additionalProperties": false, "required": ["frame"],
              "properties": {"frame": {"$ref": "#/$defs/frame"}}}
          ]
        },
        "id": {"$ref": "#/$defs/id"},
        "gain": {"type": "number", "minimum": -30, "maximum": 6}
      }
    },
    "textSlot": {
      "type": "object", "additionalProperties": false, "required": ["text", "role", "factIds"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 400},
        "role": {"enum": ["headline", "body", "label", "number", "quote", "caption", "cta"]},
        "factIds": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "lang": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "maxLines": {"type": "integer", "minimum": 1, "maximum": 6},
        "editable": {"type": "boolean"}
      }
    },
    "box01": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "assetSlot": {
      "type": "object", "additionalProperties": false, "required": ["resourceId"],
      "properties": {
        "resourceId": {"type": "string", "pattern": "^res_[A-Za-z0-9_-]{4,64}$"},
        "roi": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/box01"}},
        "crop": {"$ref": "#/$defs/box01"},
        "editable": {"type": "boolean"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["type", "frames"],
      "properties": {
        "type": {"enum": ["cut", "crossfade", "push", "whip", "wipe", "zoom-through", "match-handoff"]},
        "frames": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "sceneCommon": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "start": {"$ref": "#/$defs/frame"},
        "end": {"$ref": "#/$defs/frame"},
        "layout": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "landscape": {"type": "object"}, "portrait": {"type": "object"}, "feed": {"type": "object"}, "square": {"type": "object"}
          }
        },
        "transitionIn": {"$ref": "#/$defs/transition"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 300},
        "focusFrom": {"type": "string", "maxLength": 200},
        "focusTo": {"type": "string", "maxLength": 200}
      }
    },
    "scene": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "start", "end", "kind", "block", "params", "purpose"],
          "allOf": [{"$ref": "#/$defs/sceneCommon"}],
          "properties": {
            "id": true, "start": true, "end": true, "layout": true, "transitionIn": true, "purpose": true, "focusFrom": true, "focusTo": true,
            "kind": {"const": "block"},
            "block": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}@[0-9]{1,3}$"},
            "params": {"type": "object", "maxProperties": 64}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "start", "end", "kind", "module", "brief", "purpose"],
          "allOf": [{"$ref": "#/$defs/sceneCommon"}],
          "properties": {
            "id": true, "start": true, "end": true, "layout": true, "transitionIn": true, "purpose": true, "focusFrom": true, "focusTo": true,
            "kind": {"const": "custom"},
            "module": {"type": "string", "pattern": "^scenes/[a-z][a-z0-9-]{0,47}/index\\.js$"},
            "brief": {"type": "string", "minLength": 1, "maxLength": 2000},
            "params": {"type": "object", "maxProperties": 64}
          }
        }
      ]
    },
    "treatment": {
      "type": "object", "additionalProperties": false, "required": ["message", "hook", "energyCurve", "continuity"],
      "properties": {
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "hook": {"type": "string", "minLength": 1, "maxLength": 500},
        "energyCurve": {
          "type": "array", "minItems": 2, "maxItems": 30,
          "items": {"type": "object", "additionalProperties": false, "required": ["frame", "level"],
            "properties": {"frame": {"$ref": "#/$defs/frame"}, "level": {"type": "integer", "minimum": 0, "maximum": 5}}}
        },
        "holds": {
          "type": "array", "maxItems": 20,
          "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "reason"],
            "properties": {"start": {"$ref": "#/$defs/frame"}, "end": {"$ref": "#/$defs/frame"}, "reason": {"type": "string", "minLength": 1, "maxLength": 200}}}
        },
        "continuity": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
