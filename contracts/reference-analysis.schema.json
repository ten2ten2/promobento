{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/reference-analysis/3.0.0",
  "title": "Source-bound reference video observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "resourceId", "sourceSha256", "sourceFrameCount", "sampledFrames", "audioStatus", "summary", "moments", "relationships"],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "kind": {"const": "reference_analysis"},
    "resourceId": {"type": "string", "minLength": 1, "maxLength": 120},
    "sourceSha256": {"$ref": "#/$defs/hash"},
    "sourceFrameCount": {"type": "integer", "minimum": 1, "maximum": 1800},
    "sampledFrames": {"type": "array", "minItems": 2, "maxItems": 24, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1799}},
    "audioStatus": {"const": "not_analyzed"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["hook", "progression", "payoff", "visualSystem", "limitations"], "properties": {
      "hook": {"$ref": "#/$defs/description"},
      "progression": {"$ref": "#/$defs/description"},
      "payoff": {"$ref": "#/$defs/description"},
      "visualSystem": {"$ref": "#/$defs/description"},
      "limitations": {"$ref": "#/$defs/description"}
    }},
    "moments": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["id", "startFrame", "endFrame", "evidenceFrames", "visible", "interpretation", "visibleText"], "properties": {
      "id": {"$ref": "#/$defs/id"},
      "startFrame": {"type": "integer", "minimum": 0, "maximum": 1799},
      "endFrame": {"type": "integer", "minimum": 1, "maximum": 1800},
      "evidenceFrames": {"$ref": "#/$defs/evidence"},
      "visible": {"$ref": "#/$defs/description"},
      "interpretation": {"type": ["string", "null"], "maxLength": 1000},
      "visibleText": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 160}}
    }}},
    "relationships": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["fromMomentId", "toMomentId", "description", "evidenceFrames"], "properties": {
      "fromMomentId": {"$ref": "#/$defs/id"},
      "toMomentId": {"$ref": "#/$defs/id"},
      "description": {"$ref": "#/$defs/description"},
      "evidenceFrames": {"$ref": "#/$defs/evidence"}
    }}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1799}}
  }
}
