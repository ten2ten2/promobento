{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/render-job/3.0.0",
  "title": "Render jobs, shard plans, shard receipts and seam reports",
  "oneOf": [
    {"$ref": "#/$defs/renderJob"},
    {"$ref": "#/$defs/shardPlan"},
    {"$ref": "#/$defs/shardReceipt"},
    {"$ref": "#/$defs/seamReport"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,96}$"},
    "aspectId": {"enum": ["landscape", "portrait", "feed", "square"]},
    "frame": {"type": "integer", "minimum": 0, "maximum": 900},
    "renderProfile": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["sampleCount", "shutterAngle", "sampling", "edgePolicy"],
          "properties": {"sampleCount": {"const": 1}, "shutterAngle": {"const": 0}, "sampling": {"const": "centered-box-v1"}, "edgePolicy": {"const": "clamp-v1"}}},
        {"type": "object", "additionalProperties": false, "required": ["sampleCount", "shutterAngle", "sampling", "edgePolicy"],
          "properties": {"sampleCount": {"enum": [4, 8]}, "shutterAngle": {"const": 180}, "sampling": {"const": "centered-box-v1"}, "edgePolicy": {"const": "clamp-v1"}}}
      ]
    },
    "renderJob": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "renderId", "operationId", "candidateId", "sourceHash", "runtimeVersion", "rendererRelease", "aspectId", "durationSeconds", "totalFrames", "quality", "renderProfile", "resources"],
      "properties": {
        "schemaVersion": {"const": "3.0.0"},
        "kind": {"const": "render_job"},
        "renderId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "revisionId": {"$ref": "#/$defs/id"},
        "candidateId": {"$ref": "#/$defs/id"},
        "sourceHash": {"$ref": "#/$defs/sha256"},
        "runtimeVersion": {"type": "string", "minLength": 1, "maxLength": 80},
        "rendererRelease": {"type": "string", "minLength": 1, "maxLength": 120},
        "aspectId": {"$ref": "#/$defs/aspectId"},
        "durationSeconds": {"enum": [15, 30]},
        "totalFrames": {"enum": [450, 900]},
        "quality": {"enum": ["still", "review", "final"]},
        "renderProfile": {"$ref": "#/$defs/renderProfile"},
        "resources": {
          "type": "array", "maxItems": 200,
          "items": {"type": "object", "additionalProperties": false, "required": ["resourceId", "sha256", "kind"],
            "properties": {"resourceId": {"type": "string", "pattern": "^res_[A-Za-z0-9_-]{4,64}$"}, "sha256": {"$ref": "#/$defs/sha256"}, "kind": {"enum": ["image", "video", "audio", "font", "svg"]}}}
        },
        "audioPlanHash": {"$ref": "#/$defs/sha256"},
        "frozenAudioHash": {"$ref": "#/$defs/sha256"},
        "frames": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/frame"}},
        "crops": {
          "type": "array", "maxItems": 8,
          "items": {"type": "object", "additionalProperties": false, "required": ["frame", "x01", "y01", "scale"],
            "properties": {"frame": {"$ref": "#/$defs/frame"}, "x01": {"type": "number", "minimum": 0, "maximum": 1}, "y01": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"const": 2}}}
        },
        "reuse": {
          "type": "array", "maxItems": 64,
          "items": {"type": "object", "additionalProperties": false, "required": ["shardKey", "renderId", "shardIndex"],
            "properties": {"shardKey": {"$ref": "#/$defs/sha256"}, "renderId": {"$ref": "#/$defs/id"}, "shardIndex": {"type": "integer", "minimum": 0, "maximum": 63}}}
        }
      }
    },
    "shardPlan": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "renderId", "totalFrames", "shards"],
      "properties": {
        "schemaVersion": {"const": "3.0.0"},
        "kind": {"const": "shard_plan"},
        "renderId": {"$ref": "#/$defs/id"},
        "totalFrames": {"enum": [450, 900]},
        "shards": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"type": "object", "additionalProperties": false, "required": ["index", "start", "end", "instance", "shardKey"],
            "properties": {
              "index": {"type": "integer", "minimum": 0, "maximum": 63},
              "start": {"$ref": "#/$defs/frame"},
              "end": {"$ref": "#/$defs/frame"},
              "instance": {"enum": ["standard-3", "standard-4"]},
              "shardKey": {"$ref": "#/$defs/sha256"},
              "reused": {"type": "boolean"}
            }}
        }
      }
    },
    "shardReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "renderId", "shardIndex", "start", "end", "imageDigest", "chromiumVersion", "cpuModel", "cpuFlagsHash", "sandbox", "captureFormat", "timings", "peakMemoryMiB", "outputs"],
      "properties": {
        "schemaVersion": {"const": "3.0.0"},
        "kind": {"const": "shard_receipt"},
        "renderId": {"$ref": "#/$defs/id"},
        "shardIndex": {"type": "integer", "minimum": 0, "maximum": 63},
        "start": {"$ref": "#/$defs/frame"},
        "end": {"$ref": "#/$defs/frame"},
        "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "chromiumVersion": {"type": "string", "minLength": 1, "maxLength": 40},
        "cpuModel": {"type": "string", "maxLength": 120},
        "cpuFlagsHash": {"$ref": "#/$defs/sha256"},
        "sandbox": {
          "type": "object", "additionalProperties": false, "required": ["seccomp", "nestedPidNamespace", "separateUserNamespace", "chromiumUid"],
          "properties": {"seccomp": {"type": "boolean"}, "nestedPidNamespace": {"type": "boolean"}, "separateUserNamespace": {"type": "boolean"}, "chromiumUid": {"type": "integer"}}
        },
        "captureFormat": {"enum": ["jpeg92", "png"]},
        "timings": {
          "type": "object", "additionalProperties": false, "required": ["readyMs", "handshakeMs", "renderMs", "encodeDrainMs"],
          "properties": {"readyMs": {"type": "integer", "minimum": 0}, "handshakeMs": {"type": "integer", "minimum": 0}, "renderMs": {"type": "integer", "minimum": 0}, "encodeDrainMs": {"type": "integer", "minimum": 0}}
        },
        "peakMemoryMiB": {"type": "integer", "minimum": 0},
        "outputs": {
          "type": "object", "additionalProperties": false, "required": ["shard", "frameDigests", "seamFrames", "observations"],
          "properties": {
            "shard": {"$ref": "#/$defs/sha256"}, "frameDigests": {"$ref": "#/$defs/sha256"}, "observations": {"$ref": "#/$defs/sha256"},
            "seamFrames": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "seamReport": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "renderId", "seams"],
      "properties": {
        "schemaVersion": {"const": "3.0.0"},
        "kind": {"const": "seam_report"},
        "renderId": {"$ref": "#/$defs/id"},
        "seams": {
          "type": "array", "maxItems": 63,
          "items": {"type": "object", "additionalProperties": false, "required": ["frame", "identical", "maxChannelDiff", "diffPixelPct", "verdict"],
            "properties": {
              "frame": {"$ref": "#/$defs/frame"},
              "identical": {"type": "boolean"},
              "maxChannelDiff": {"type": "integer", "minimum": 0, "maximum": 255},
              "diffPixelPct": {"type": "number", "minimum": 0, "maximum": 100},
              "verdict": {"enum": ["pass", "pass_within_tolerance", "RENDER_SEAM_BLOCK"]},
              "sceneId": {"type": "string", "maxLength": 48}
            }}
        }
      }
    }
  }
}
