{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/admission-media-commands.schema.json",
  "title": "canvas-media-v1 data result",
  "type": "object",
  "required": [
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "commands": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "regions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "number",
      "minimum": -16384,
      "maximum": 16384
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "maximum": 16384
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "minLength": 7,
      "maxLength": 7
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/rect"
        },
        {
          "$ref": "#/$defs/circle"
        },
        {
          "$ref": "#/$defs/polygon"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/video"
        },
        {
          "$ref": "#/$defs/path"
        },
        {
          "$ref": "#/$defs/texture"
        }
      ]
    },
    "rect": {
      "type": "object",
      "required": [
        "op",
        "x",
        "y",
        "width",
        "height",
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "rect"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "radius": {
          "$ref": "#/$defs/size"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "fill": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        }
      }
    },
    "circle": {
      "type": "object",
      "required": [
        "op",
        "x",
        "y",
        "radius",
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "circle"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "radius": {
          "$ref": "#/$defs/size"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "fill": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        }
      }
    },
    "polygon": {
      "type": "object",
      "required": [
        "op",
        "points",
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "fill": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "x": {
          "$ref": "#/$defs/size"
        },
        "y": {
          "$ref": "#/$defs/size"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "op",
        "x",
        "y",
        "width",
        "height",
        "opacity",
        "id",
        "fontId",
        "text",
        "fontSize",
        "weight",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "text"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "fontId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "fontSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 512
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "wrap": {
              "enum": [
                "none",
                "word-cjk"
              ]
            },
            "lineHeight": {
              "type": "number",
              "minimum": 1,
              "maximum": 1024
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "op",
        "x",
        "y",
        "width",
        "height",
        "opacity",
        "resourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "image"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        },
        "crop": {
          "$ref": "#/$defs/crop"
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "cell",
            "seed"
          ],
          "properties": {
            "style": {
              "enum": [
                "halftone",
                "mosaic",
                "brush"
              ]
            },
            "cell": {
              "type": "integer",
              "minimum": 4,
              "maximum": 32
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "op",
        "x",
        "y",
        "width",
        "height",
        "opacity",
        "useId"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "video"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "useId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        },
        "crop": {
          "$ref": "#/$defs/crop"
        }
      }
    },
    "transform": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number",
        "minimum": -16384,
        "maximum": 16384
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "radius": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "width"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "cap": {
          "enum": [
            "butt",
            "round",
            "square"
          ]
        },
        "join": {
          "enum": [
            "round",
            "bevel",
            "miter"
          ]
        },
        "dash": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1024
          }
        },
        "dashOffset": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "gradient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "x0",
        "y0",
        "x1",
        "y1",
        "stops"
      ],
      "properties": {
        "kind": {
          "enum": [
            "linear",
            "radial"
          ]
        },
        "x0": {
          "$ref": "#/$defs/coordinate"
        },
        "y0": {
          "$ref": "#/$defs/coordinate"
        },
        "x1": {
          "$ref": "#/$defs/coordinate"
        },
        "y1": {
          "$ref": "#/$defs/coordinate"
        },
        "r0": {
          "$ref": "#/$defs/size"
        },
        "r1": {
          "$ref": "#/$defs/size"
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "color"
            ],
            "properties": {
              "offset": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "color": {
                "$ref": "#/$defs/color"
              }
            }
          }
        }
      }
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "move"
            },
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "line"
            },
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cx",
            "cy",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "quadratic"
            },
            "cx": {
              "$ref": "#/$defs/coordinate"
            },
            "cy": {
              "$ref": "#/$defs/coordinate"
            },
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cx1",
            "cy1",
            "cx2",
            "cy2",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "cubic"
            },
            "cx1": {
              "$ref": "#/$defs/coordinate"
            },
            "cy1": {
              "$ref": "#/$defs/coordinate"
            },
            "cx2": {
              "$ref": "#/$defs/coordinate"
            },
            "cy2": {
              "$ref": "#/$defs/coordinate"
            },
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "close"
            }
          }
        }
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "segments",
        "color",
        "opacity"
      ],
      "properties": {
        "op": {
          "const": "path"
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "fill": {
          "type": "boolean"
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "x",
        "y",
        "width",
        "height",
        "color",
        "accent",
        "opacity",
        "style",
        "seed"
      ],
      "properties": {
        "op": {
          "const": "texture"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "style": {
          "enum": [
            "paper",
            "grain",
            "halftone",
            "mosaic",
            "brush"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 16
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
