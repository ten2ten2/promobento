{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/admission-source/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "capabilityProfile",
    "targetId",
    "durationSeconds",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.7.0"
    },
    "kind": {
      "const": "admission_candidate"
    },
    "capabilityProfile": {
      "enum": [
        "canvas-commands-v1",
        "canvas-media-v1"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "durationSeconds": {
      "enum": [
        15,
        30
      ]
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
