{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/agent-tools/3.0.0",
  "title": "Native huashu director tools",
  "description": "Validated production documents, native source writes, revision-fenced patches and reviews. JSON is not an executable film specification.",
  "oneOf": [
    {
      "$ref": "#/$defs/call_write_treatment"
    },
    {
      "$ref": "#/$defs/call_write_project"
    },
    {
      "$ref": "#/$defs/call_apply_project_patch"
    },
    {
      "$ref": "#/$defs/call_submit_review"
    }
  ],
  "$defs": {
    "write_treatmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "beats",
        "hardestBeat",
        "reviewFrames"
      ],
      "properties": {
        "treatment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "startFrame",
              "endFrame",
              "assetIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 899
              },
              "endFrame": {
                "type": "integer",
                "minimum": 1,
                "maximum": 900
              },
              "assetIds": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        },
        "hardestBeat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "reviewFrames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 899
          }
        }
      }
    },
    "call_write_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "tool",
        "input"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "kind": {
          "const": "tool_call"
        },
        "tool": {
          "const": "write_treatment"
        },
        "input": {
          "$ref": "#/$defs/write_treatmentInput"
        }
      }
    },
    "write_projectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "reviewFrames",
        "note"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(index\\.(html|js|css)|src/[A-Za-z0-9_./-]+\\.(html|js|css|svg|json)|BRIEF\\.md|TREATMENT\\.md|script\\.json)$",
                "maxLength": 180
              },
              "content": {
                "type": "string",
                "maxLength": 240000
              }
            }
          }
        },
        "reviewFrames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 899
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "call_write_project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "tool",
        "input"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "kind": {
          "const": "tool_call"
        },
        "tool": {
          "const": "write_project"
        },
        "input": {
          "$ref": "#/$defs/write_projectInput"
        }
      }
    },
    "apply_project_patchInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRevision",
        "edits",
        "reviewFrames",
        "note"
      ],
      "properties": {
        "baseRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command",
                  "path",
                  "content"
                ],
                "properties": {
                  "command": {
                    "const": "create"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(index\\.(html|js|css)|src/[A-Za-z0-9_./-]+\\.(html|js|css|svg|json)|BRIEF\\.md|TREATMENT\\.md|script\\.json)$",
                    "maxLength": 180
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 240000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command",
                  "path",
                  "oldText",
                  "newText"
                ],
                "properties": {
                  "command": {
                    "const": "replace"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(index\\.(html|js|css)|src/[A-Za-z0-9_./-]+\\.(html|js|css|svg|json)|BRIEF\\.md|TREATMENT\\.md|script\\.json)$",
                    "maxLength": 180
                  },
                  "oldText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240000
                  },
                  "newText": {
                    "type": "string",
                    "maxLength": 240000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command",
                  "path"
                ],
                "properties": {
                  "command": {
                    "const": "delete"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(index\\.(html|js|css)|src/[A-Za-z0-9_./-]+\\.(html|js|css|svg|json)|BRIEF\\.md|TREATMENT\\.md|script\\.json)$",
                    "maxLength": 180
                  }
                }
              }
            ]
          }
        },
        "reviewFrames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 899
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "call_apply_project_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "tool",
        "input"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "kind": {
          "const": "tool_call"
        },
        "tool": {
          "const": "apply_project_patch"
        },
        "input": {
          "$ref": "#/$defs/apply_project_patchInput"
        }
      }
    },
    "submit_reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "issues",
        "note"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "revise"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detail",
              "frames"
            ],
            "properties": {
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 899
                }
              },
              "elementId": {
                "type": "string",
                "maxLength": 100
              },
              "aspect": {
                "enum": [
                  "landscape",
                  "portrait",
                  "feed",
                  "square"
                ]
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "call_submit_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "tool",
        "input"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "kind": {
          "const": "tool_call"
        },
        "tool": {
          "const": "submit_review"
        },
        "input": {
          "$ref": "#/$defs/submit_reviewInput"
        }
      }
    }
  }
}
