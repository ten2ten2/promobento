{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/agent-tools/3.0.0",
  "title": "Director tool calls",
  "description": "Inputs of the director's tools (cloud motion plan §6.8). Every call is validated here before it runs, billed and written to the ledger. Large payloads (write_spec, audio_plan) are also validated against their own Schemas.",
  "oneOf": [
    {"$ref": "#/$defs/call_brief_context"}, {"$ref": "#/$defs/call_asset_insights"}, {"$ref": "#/$defs/call_method_recall"},
    {"$ref": "#/$defs/call_block_catalog"}, {"$ref": "#/$defs/call_submit_directions"}, {"$ref": "#/$defs/call_write_spec"},
    {"$ref": "#/$defs/call_spec_patch"}, {"$ref": "#/$defs/call_edit_file"}, {"$ref": "#/$defs/call_check"},
    {"$ref": "#/$defs/call_still"}, {"$ref": "#/$defs/call_review"}, {"$ref": "#/$defs/call_audio_plan"},
    {"$ref": "#/$defs/call_submit_candidate"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "aspectId": {"enum": ["landscape", "portrait", "feed", "square"]},
    "frame": {"type": "integer", "minimum": 0, "maximum": 900},
    "scenePath": {"type": "string", "pattern": "^scenes/[a-z][a-z0-9-]{0,47}/[A-Za-z0-9._-]{1,64}\\.(js|css|svg|json|abc)$"},
    "empty": {"type": "object", "additionalProperties": false, "properties": {}},

    "call_brief_context": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "brief_context"}, "input": {"$ref": "#/$defs/empty"}}},
    "call_asset_insights": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "asset_insights"},
        "input": {"type": "object", "additionalProperties": false, "properties": {"assetKeys": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}}},
    "call_method_recall": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "method_recall"},
        "input": {"type": "object", "additionalProperties": false, "required": ["topics", "stage"],
          "properties": {"topics": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
            "stage": {"enum": ["directions", "spec", "scenes", "review"]}}}}},
    "call_block_catalog": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "block_catalog"},
        "input": {"type": "object", "additionalProperties": false,
          "properties": {"category": {"enum": ["opening", "software", "data", "course", "3d", "closing", "transition"]}, "ids": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/id"}}}}}},
    "call_submit_directions": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "submit_directions"},
        "input": {"description": "A direction_set; validated against direction.schema.json.", "type": "object", "required": ["cards"], "properties": {"cards": {"type": "array", "minItems": 3, "maxItems": 3}}}}},
    "call_write_spec": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "write_spec"},
        "input": {"description": "A FilmSpec; validated against film.schema.json and filmSpecErrors().", "type": "object", "required": ["film"], "additionalProperties": false, "properties": {"film": {"type": "object"}}}}},
    "call_spec_patch": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "spec_patch"},
        "input": {"type": "object", "additionalProperties": false, "required": ["ops"],
          "properties": {"ops": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
            "type": "object", "additionalProperties": false, "required": ["op", "path"],
            "properties": {"op": {"enum": ["add", "remove", "replace", "move", "copy", "test"]},
              "path": {"type": "string", "pattern": "^(/[^/]*)+$", "maxLength": 300},
              "from": {"type": "string", "pattern": "^(/[^/]*)+$", "maxLength": 300},
              "value": true}}}}}}},
    "call_edit_file": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "edit_file"},
        "input": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["command", "path"],
            "properties": {"command": {"const": "view"}, "path": {"$ref": "#/$defs/scenePath"}}},
          {"type": "object", "additionalProperties": false, "required": ["command", "path", "fileText"],
            "properties": {"command": {"const": "create"}, "path": {"$ref": "#/$defs/scenePath"}, "fileText": {"type": "string", "maxLength": 200000}}},
          {"type": "object", "additionalProperties": false, "required": ["command", "path", "oldStr", "newStr"],
            "properties": {"command": {"const": "str_replace"}, "path": {"$ref": "#/$defs/scenePath"}, "oldStr": {"type": "string", "minLength": 1, "maxLength": 100000}, "newStr": {"type": "string", "maxLength": 100000}}},
          {"type": "object", "additionalProperties": false, "required": ["command", "path", "insertLine", "newStr"],
            "properties": {"command": {"const": "insert"}, "path": {"$ref": "#/$defs/scenePath"}, "insertLine": {"type": "integer", "minimum": 0}, "newStr": {"type": "string", "maxLength": 100000}}}
        ]}}},
    "call_check": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "check"},
        "input": {"type": "object", "additionalProperties": false, "required": ["scope"],
          "properties": {"scope": {"oneOf": [{"const": "film"}, {"type": "object", "additionalProperties": false, "required": ["sceneId"], "properties": {"sceneId": {"$ref": "#/$defs/id"}}}]},
            "frames": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/frame"}}}}}},
    "call_still": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "still"},
        "input": {"type": "object", "additionalProperties": false, "required": ["frames", "aspect", "scale"],
          "properties": {"frames": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/frame"}},
            "aspect": {"$ref": "#/$defs/aspectId"},
            "scale": {"enum": [0.25, 0.5, 1]},
            "crop": {"type": "object", "additionalProperties": false, "required": ["x01", "y01"],
              "properties": {"x01": {"type": "number", "minimum": 0, "maximum": 1}, "y01": {"type": "number", "minimum": 0, "maximum": 1}}}}}}},
    "call_review": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "review"}, "input": {"$ref": "#/$defs/empty"}}},
    "call_audio_plan": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "audio_plan"},
        "input": {"description": "Overrides on the derived plan; validated against audio-plan.schema.json after derivation.", "type": "object", "additionalProperties": false,
          "properties": {"music": {"type": "object"}, "sfx": {"oneOf": [{"const": "auto"}, {"type": "array", "maxItems": 120}]}}}}},
    "call_submit_candidate": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "tool", "input"],
      "properties": {"schemaVersion": {"const": "3.0.0"}, "kind": {"const": "tool_call"}, "tool": {"const": "submit_candidate"},
        "input": {"type": "object", "additionalProperties": false, "required": ["note"], "properties": {"note": {"type": "string", "minLength": 1, "maxLength": 4000}}}}}
  }
}
