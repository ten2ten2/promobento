{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/admission-audio-rights.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "approvals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.7.0"
    },
    "kind": {
      "const": "admission_audio_rights"
    },
    "approvals": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "requestHash",
          "basis",
          "evidenceRef",
          "reviewer",
          "allowedUses"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "basis": {
            "enum": [
              "original_composition_reviewed",
              "licensed_composition_reviewed"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "allowedUses": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "process",
                "mix",
                "preview",
                "export"
              ]
            }
          }
        }
      }
    }
  }
}
