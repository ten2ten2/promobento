jects/:projectId/edit-requests","auth":"member","requestDef":"editRequest","responseDef":"runResult","successStatus":202,"purpose":"一次明确的Agent改稿，建立候选，不覆盖当前稿"},{"routeId":"patches.get","method":"GET","path":"/api/projects/:projectId/patches/:patchId","auth":"member","requestDef":null,"responseDef":"patchResult","successStatus":200,"purpose":"显示diff影响和候选状态"},{"routeId":"patches.apply","method":"POST","path":"/api/projects/:projectId/patches/:patchId/apply","auth":"member","requestDef":"applyRequest","responseDef":"patchResult","successStatus":200,"purpose":"接受：CAS与权限/QA同事务"},{"routeId":"patches.reject","method":"POST","path":"/api/projects/:projectId/patches/:patchId/reject","auth":"member","requestDef":"applyRequest","responseDef":"patchResult","successStatus":200,"purpose":"拒绝候选，不修改当前版本"},{"routeId":"quality_reports.list","method":"GET","path":"/api/projects/:projectId/quality-reports/:revisionId","auth":"member","requestDef":null,"responseDef":"qualitySummary","successStatus":200,"purpose":"读取匹配源码hash的逐目标报告；不直接回传敏感prompt"},{"method":"POST","path":"/api/projects/:projectId/export-snapshots","auth":"member","routeId":"snapshots.create","requestDef":"snapshotRequest","responseDef":"releaseSnapshot","successStatus":200,"purpose":"只冻结全部合法target已准备的源包；缺项409"},{"method":"POST","path":"/api/projects/:projectId/exports","auth":"member","routeId":"exports.create","requestDef":"exportRequest","responseDef":"exportManifest","successStatus":202,"purpose":"原成片版本账本预留/复用release"},{"method":"POST","path":"/api/exports/:releaseId/platforms","auth":"member","routeId":"exports.add_platforms","requestDef":"platformRequest","responseDef":"exportManifest","successStatus":202,"purpose":"只运行既有冻结target；没有Agent创作"},{"method":"POST","path":"/api/projects/:projectId/preflight","auth":"member","routeId":"preflight.run","requestDef":"preflightRequest","responseDef":"qualitySummary","successStatus":200,"purpose":"检查当前revision，不触发支付"}],"retiredUnreleasedRoutes":["/api/projects/:projectId/storyboar