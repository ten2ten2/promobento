t","responseDef":"qualitySummary","successStatus":200,"purpose":"检查当前 revision；不触发支付"},{"routeId":"projects.create","method":"POST","path":"/api/projects","auth":"member","requestDef":"createProjectRequest","responseDef":"createProjectResult","successStatus":201,"purpose":"创建草稿；requestTrial仅Owner为自己申请，已耗尽仍创建无免费权益草稿"},{"routeId":"billing.checkouts.create","method":"POST","path":"/api/billing/checkouts","auth":"owner","requestDef":"checkoutRequest","responseDef":"checkoutResult","successStatus":201,"purpose":"核验SKU/购买意图后创建或复用订单；返回受控状态和有效https结账地址，不透传提供方原始响应"},{"routeId":"assets.create_intent","method":"POST","path":"/api/projects/:projectId/assets/intents","auth":"member","requestDef":"assetIntentRequest","responseDef":"assetIntentResult","successStatus":201,"purpose":"绑定预期原始字节与处理权利声明，预算/权限通过后签发短期上传目标"},{"routeId":"uploads.complete","method":"POST","path":"/api/uploads/:uploadId/complete","auth":"member","requestDef":"uploadCompleteRequest","responseDef":"uploadCompleteResult","successStatus":202,"purpose":"按intent核验实收字节和声明后入处理队列；evidence不成为可绘素材"},{"routeId":"facts.get","method":"GET","path":"/api/projects/:projectId/facts","auth":"member","requestDef":null,"responseDef":"factsResult","successStatus":200,"purpose":"读取当前事实版本、证据及确认状态"},{"routeId":"facts.update","method":"PATCH","path":"/api/projects/:projectId/facts","auth":"member","requestDef":"factsUpdateRequest","responseDef":"factsResult","successStatus":200,"purpose":"事实批量创建/修改/删除按逐项expectedVersion原子CAS；更新撤销该事实当前确认"},{"routeId":"facts.confirm","method":"POST","path":"/api/projects/:projectId/facts/confirm","auth":"member","requestDef":"factsConfirmRequest","responseDef":"factsResult","successStatus":200,"purpose":"确认当前factId/version/textHash，确认人和UTC由可信服务写入"},{"routeId":"transcripts.get","method":"GET","path":"/api/projects/:projectId/transcripts/:assetId","auth":"member","requestDef":null,"responseDef":"transcriptResult","successStatus":200,"purpose":"读取当前选用音源的已确认转写；未确认时404"},{"routeId":"transcripts.confirm","method":"POST","path":"/api/projects/:projectId/transcripts/confirm","auth":"member","requestDef":"transcriptConfirmRequest","responseDef":"transcriptResult","successStatus":200,"purpose":"显式确认手填或修订稿，绑定不可变assetId/sourceHash及当前事实引用"},{"routeId":"showcase_consents.get","method":"GET","path":"/api/projects/:projectId/showcase-consents/:releaseId","auth":"owner","requestDef":null,"responseDef":"showcaseConsentResult","successStatus":200,"purpose":"读取指定交付的独立案例展示同意状态；不授予公开展示权"},{"routeId":"showcase_consents.update","method":"PUT","path":"/api/projects/:projectId/showcase-consents/:releaseId","auth":"owner","requestDef":"showcaseConsentRequest","responseDef":"showcaseConsentResult","successStatus":200,"purpose":"按expectedVersion授予或撤回指定交付和渠道的展示同意；与生产权益分开"},{"routeId":"support.tickets.create","method":"POST","path":"/api/support/tickets","auth":"session","requestDef":"supportTicketRequest","responseDef":"supportTicketResult","successStatus":201,"purpose":"常规支持或Owner退款申请；退款仅记录requested，不宣称资金退回"},{"routeId":"exports.get","method":"GET","path":"/api/exports/:releaseId","auth":"member","requestDef":null,"responseDef":"exportManifest","successStatus":200,"purpose":"刷新后读取持久release和导出manifest；不签发下载地址"},{"routeId":"snapshots.get","method":"GET","path":"/api/projects/:projectId/export-snapshots/:snapshotId","auth":"member","requestDef":null,"responseDef":"releaseSnapshot","successStatus":200,"purpose":"只读授权范围内的不可变确认快照，不重新准备或导出"},{"routeId":"projects.get","method":"GET","path":"/api/projects/:projectId","auth":"member","requestDef":null,"responseDef":"projectResult","successStatus":200,"purpose":"读取草稿、期限、余额及服务端派生的availableActions；不在前端重建购买资格"},{"routeId":"projects.update_draft","method":"PATCH","path":"/api/projects/:projectId/draft","auth":"member","requestDef":"draftUpdateRequest","responseDef":"draftUpdateResult","successStatus":200,"purpose":"普通变量或恢复按baseRevision CAS保存；409带当前revision，事实变更撤销确认，保存不运行云QA"},{"routeId":"jobs.get","method":"GET","path":"/api/jobs/:jobId","auth":"member","requestDef":null,"responseDef":"jobResult","successStatus":200,"purpose":"读取归属当前授权项目的真实阶段、进度、稳定错误码和可重试性"},{"routeId":"preview_sessions.create","method":"POST","path":"/api/projects/:projectId/preview-sessions","auth":"member","requestDef":"previewSessionRequest","responseDef":"previewSessionResult","successStatus":201,"purpose":"为已有授权来源签发隔离的完整本地低清播放会话；不准备目标、不运行云QA或视频编码"}]}
