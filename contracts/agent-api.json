{"schemaVersion":"2.7.0","status":"prd_seed","sourceDocument":"docs/prd/14-production-contracts.md","schemaSource":"contracts/production.schema.json","idempotency":{"header":"Idempotency-Key","bodyField":"requestId","whenBothPresent":"must_equal","uniqueScope":["workspaceId","projectId","actorId","routeId","requestId"],"differentBodyStatus":409},"commonErrors":[401,403,404,409,422,429,503],"endpoints":[{"routeId":"agent_runs.create","method":"POST","path":"/api/projects/:projectId/agent-runs","auth":"member","requestDef":"agentRequest","responseDef":"runResult","successStatus":202,"purpose":"启动整片创作或显式准备平台源包；首次创作baseRevision为null，CAS要求当前草稿为空"},{"routeId":"agent_runs.get","method":"GET","path":"/api/projects/:projectId/agent-runs/:runId","auth":"member","requestDef":null,"responseDef":"runResult","successStatus":200,"purpose":"读取阶段、方向候选、预算与结果"},{"routeId":"agent_runs.resume","method":"POST","path":"/api/projects/:projectId/agent-runs/:runId/resume","auth":"member","requestDef":"runAction","responseDef":"runResult","successStatus":202,"purpose":"同 run 剩余预算内恢复；重新核对 base 和权限"},{"routeId":"agent_runs.cancel","method":"POST","path":"/api/projects/:projectId/agent-runs/:runId/cancel","auth":"member","requestDef":"runAction","responseDef":"runResult","successStatus":200,"purpose":"取消并使该 run 的 generation 失效；baseRevision 匹配 run，不要求它仍是当前草稿"},{"routeId":"compositions.get","method":"GET","path":"/api/projects/:projectId/compositions/:revisionId","auth":"member","requestDef":null,"responseDef":"composition","successStatus":200,"purpose":"读取授权版本元数据；源码另走短期最小权限资产代理"},{"routeId":"previews.create","method":"POST","path":"/api/projects/:projectId/previews","auth":"member","requestDef":"previewRequest","responseDef":"previewResult","successStatus":202,"purpose":"显式请求可信截图或短片段；独立费用预算、字节与AI标记证据，不用于每次改字后的整片编码"},{"routeId":"previews.get","method":"GET","path":"/api/projects/:projectId/previews/:previewId","auth":"member","requestDef":null,"responseDef":"previewResult","successStatus":200,"purpose":"读取该 revision/target 的预览状态"},{"routeId":"edit_requests.create","method":"POST","path":"/api/projects/:projectId/edit-requests","auth":"member","requestDef":"editRequest","responseDef":"runResult","successStatus":202,"purpose":"以已保存且与批注画面一致的baseRevision提交1至5条comments；合计最多4000 Unicode code points，一次产生一个候选"},{"routeId":"quality_reports.list","method":"GET","path":"/api/projects/:projectId/quality-reports/:revisionId","auth":"member","requestDef":null,"responseDef":"qualitySummary","successStatus":200,"purpose":"读取与内容和资源匹配的逐目标报告"},{"routeId":"snapshots.create","method":"POST","path":"/api/projects/:projectId/export-snapshots","auth":"member","requestDef":"snapshotRequest","responseDef":"releaseSnapshot","successStatus":200,"purpose":"只冻结全部合法 target 已准备的内容；缺项 409"},{"routeId":"exports.create","method":"POST","path":"/api/projects/:projectId/exports","auth":"member","requestDef":"exportRequest","responseDef":"exportManifest","successStatus":202,"purpose":"按 projectId + contentHash 复用或预留 release"},{"routeId":"exports.add_platforms","method":"POST","path":"/api/exports/:releaseId/platforms","auth":"member","requestDef":"platformRequest","responseDef":"exportManifest","successStatus":202,"purpose":"只执行已有冻结 target；不调用 Agent"},{"routeId":"preflight.run","method":"POST","path":"/api/projects/:projectId/preflight","auth":"member","requestDef":"preflightRequest","responseDef":"qualitySummary","successStatus":200,"purpose":"检查当前 revision；不触发支付"},{"routeId":"projects.create","method":"POST","path":"/api/projects","auth":"member","requestDef":"createProjectRequest","responseDef":"createProjectResult","successStatus":201,"purpose":"创建空草稿；trialGrantStatus只表示本次试用申请结果，当前试用状态在projects.get读取"},{"routeId":"billing.checkouts.create","method":"POST","path":"/api/billing/checkouts","auth":"owner","requestDef":"checkoutRequest","responseDef":"checkoutResult","successStatus":201,"purpose":"核验服务端购买摘要与分别同意记录；同键同请求复用旧订单，新建才检查当前售卖策略"},{"routeId":"assets.create_intent","method":"POST","path":"/api/projects/:projectId/assets/intents","auth":"member","requestDef":"assetIntentRequest","responseDef":"assetIntentResult","successStatus":201,"purpose":"绑定预期原始字节与处理权利声明，预算/权限通过后签发短期上传目标"},{"routeId":"uploads.complete","method":"POST","path":"/api/uploads/:uploadId/complete","auth":"member","requestDef":"uploadCompleteRequest","responseDef":"uploadCompleteResult","successStatus":202,"purpose":"按intent核验实收字节和声明后入处理队列；evidence不成为可绘素材"},{"routeId":"facts.get","method":"GET","path":"/api/projects/:projectId/facts","auth":"member","requestDef":null,"responseDef":"factsResult","successStatus":200,"purpose":"读取当前事实版本、证据及确认状态"},{"routeId":"facts.update","method":"PATCH","path":"/api/projects/:projectId/facts","auth":"member","requestDef":"factsUpdateRequest","responseDef":"factsResult","successStatus":200,"purpose":"事实批量创建/修改/删除按逐项expectedVersion原子CAS；更新撤销该事实当前确认"},{"routeId":"facts.confirm","method":"POST","path":"/api/projects/:projectId/facts/confirm","auth":"member","requestDef":"factsConfirmRequest","responseDef":"factsResult","successStatus":200,"purpose":"确认当前factId/version/textHash，确认人和UTC由可信服务写入"},{"routeId":"transcripts.get","method":"GET","path":"/api/projects/:projectId/transcripts/:assetId","auth":"member","requestDef":null,"responseDef":"transcriptResult","successStatus":200,"purpose":"读取当前选用音源的已确认转写；未确认时404"},{"routeId":"transcripts.confirm","method":"POST","path":"/api/projects/:projectId/transcripts/confirm","auth":"member","requestDef":"transcriptConfirmRequest","responseDef":"transcriptResult","successStatus":200,"purpose":"显式确认手填或修订稿，绑定不可变assetId/sourceHash及当前事实引用"},{"routeId":"showcase_consents.get","method":"GET","path":"/api/projects/:projectId/showcase-consents/:releaseId","auth":"owner","requestDef":null,"responseDef":"showcaseConsentResult","successStatus":200,"purpose":"读取指定交付的独立案例展示同意状态；不授予公开展示权"},{"routeId":"showcase_consents.update","method":"PUT","path":"/api/projects/:projectId/showcase-consents/:releaseId","auth":"owner","requestDef":"showcaseConsentRequest","responseDef":"showcaseConsentResult","successStatus":200,"purpose":"按expectedVersion授予或撤回指定交付和渠道的展示同意；与生产权益分开"},{"routeId":"support.tickets.create","method":"POST","path":"/api/support/tickets","auth":"session","requestDef":"supportTicketRequest","responseDef":"supportTicketResult","successStatus":201,"purpose":"常规支持或Owner退款申请；退款仅记录requested，不宣称资金退回"},{"routeId":"exports.get","method":"GET","path":"/api/exports/:releaseId","auth":"member","requestDef":null,"responseDef":"exportManifest","successStatus":200,"purpose":"刷新后读取持久release和导出manifest；不签发下载地址"},{"routeId":"snapshots.get","method":"GET","path":"/api/projects/:projectId/export-snapshots/:snapshotId","auth":"member","requestDef":null,"responseDef":"releaseSnapshot","successStatus":200,"purpose":"只读授权范围内的不可变确认快照，不重新准备或导出"},{"routeId":"projects.get","method":"GET","path":"/api/projects/:projectId","auth":"member","requestDef":null,"responseDef":"projectResult","successStatus":200,"purpose":"读取草稿、活动run、待处理候选与活动预览引用，以及期限、余额和availableActions；刷新后可恢复工作"},{"routeId":"projects.update_draft","method":"PATCH","path":"/api/projects/:projectId/draft","auth":"member","requestDef":"draftUpdateRequest","responseDef":"draftUpdateResult","successStatus":200,"purpose":"普通变量或恢复按baseRevision CAS保存；409带当前revision，事实变更撤销确认，保存不运行云QA"},{"routeId":"jobs.get","method":"GET","path":"/api/jobs/:jobId","auth":"member","requestDef":null,"responseDef":"jobResult","successStatus":200,"purpose":"仅读取素材处理作业；创作用agent_runs、可信预览用previews、导出用exports读取状态"},{"routeId":"preview_sessions.create","method":"POST","path":"/api/projects/:projectId/preview-sessions","auth":"member","requestDef":"previewSessionRequest","responseDef":"previewSessionResult","successStatus":201,"purpose":"签发授权版本的本地低清会话与任务范围音频地址；新会话就绪后平滑替换，不运行云QA或编码"},{"routeId":"candidates.get","method":"GET","path":"/api/projects/:projectId/candidates/:candidateRevisionId","auth":"member","requestDef":null,"responseDef":"candidateResult","successStatus":200,"purpose":"读取整片、改稿或目标准备候选；未通过安全审核不暴露候选内容"},{"routeId":"candidates.accept","method":"POST","path":"/api/projects/:projectId/candidates/:candidateRevisionId/accept","auth":"member","requestDef":"candidateActionRequest","responseDef":"candidateResult","successStatus":200,"purpose":"统一接受候选；同请求幂等，当前草稿CAS、权限及安全准入同时核验，冲突409"},{"routeId":"candidates.reject","method":"POST","path":"/api/projects/:projectId/candidates/:candidateRevisionId/reject","auth":"member","requestDef":"candidateActionRequest","responseDef":"candidateResult","successStatus":200,"purpose":"统一拒绝候选；幂等，不要求旧base仍为当前草稿，不修改当前稿"},{"routeId":"checkout_disclosures.create","method":"POST","path":"/api/projects/:projectId/checkout-disclosures","auth":"owner","requestDef":"checkoutDisclosureRequest","responseDef":"checkoutDisclosureResult","successStatus":201,"purpose":"服务端固定本次购买摘要及分别同意的条目；不创建支付或冒充已同意"}]}
