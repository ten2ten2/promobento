{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/admission-resources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "resourceIds",
    "audioEvents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.7.0"
    },
    "kind": {
      "const": "admission_resources"
    },
    "resourceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "maxLength": 128
      }
    },
    "audioEvents": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "kind",
          "sourceId",
          "frameStart",
          "frameEndExclusive",
          "sourceOffsetFrames",
          "gainDb",
          "fadeInFrames",
          "fadeOutFrames"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "music",
              "sfx"
            ]
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "maxLength": 128
          },
          "frameStart": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "frameEndExclusive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "sourceOffsetFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "gainDb": {
            "type": "number",
            "minimum": -96,
            "maximum": 24
          },
          "fadeInFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "fadeOutFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "gainAutomation": {
            "type": "array",
            "minItems": 2,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frameOffset",
                "gainDb"
              ],
              "properties": {
                "frameOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 900
                },
                "gainDb": {
                  "type": "number",
                  "minimum": -96,
                  "maximum": 24
                }
              }
            }
          }
        }
      }
    },
    "generatedAudio": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "algorithmVersion",
              "seed",
              "marks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "kind": {
                "const": "abc_score"
              },
              "algorithmVersion": {
                "const": "huashu-audio-v1"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "abc": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "scoreId": {
                "enum": [
                  "launch",
                  "lesson"
                ]
              },
              "marks": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "frameIndex"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "frameIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 900
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "abc"
                ],
                "properties": {
                  "abc": {}
                }
              },
              {
                "required": [
                  "scoreId"
                ],
                "properties": {
                  "scoreId": {}
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "algorithmVersion",
              "seed",
              "style",
              "bpm",
              "root",
              "sections",
              "ending"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "kind": {
                "const": "procedural_score"
              },
              "algorithmVersion": {
                "const": "huashu-audio-v1"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "style": {
                "enum": [
                  "mallet",
                  "pulse",
                  "lofi",
                  "funk",
                  "trap",
                  "chiptune",
                  "ambient",
                  "piano",
                  "cinematic",
                  "pizzicato",
                  "acoustic",
                  "guofeng",
                  "synthwave",
                  "pulse:dark",
                  "trap:phonk",
                  "acoustic:ukulele",
                  "guofeng:dizi",
                  "guofeng:erhu",
                  "guofeng:guochao"
                ]
              },
              "bpm": {
                "type": "number",
                "minimum": 40,
                "maximum": 200
              },
              "root": {
                "type": "integer",
                "minimum": 48,
                "maximum": 72
              },
              "sections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "frameIndex",
                    "energy"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "maxLength": 128
                    },
                    "frameIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 900
                    },
                    "energy": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "ending": {
                "enum": [
                  "ring",
                  "button",
                  "stop"
                ]
              },
              "channelEffects": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "algorithmVersion",
              "seed",
              "effect",
              "kit",
              "durationFrames",
              "pitch"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128
              },
              "kind": {
                "const": "sfx"
              },
              "algorithmVersion": {
                "const": "huashu-audio-v1"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "effect": {
                "enum": [
                  "pop",
                  "tick",
                  "click",
                  "whoosh",
                  "whip",
                  "thud",
                  "impact",
                  "paper",
                  "stamp",
                  "ding",
                  "chime",
                  "sparkle",
                  "count",
                  "riser",
                  "draw",
                  "type",
                  "boing",
                  "slide",
                  "hit",
                  "subdrop",
                  "reverse",
                  "glitch",
                  "shutter"
                ]
              },
              "kit": {
                "enum": [
                  "clean",
                  "chip",
                  "lofi",
                  "cinematic",
                  "organic"
                ]
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "pitch": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              }
            }
          }
        ]
      }
    }
  }
}
