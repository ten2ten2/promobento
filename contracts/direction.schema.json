{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/direction/3.0.0",
  "title": "Direction cards (Fit / Amplify / Unexpected)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "cards"],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "kind": {"const": "direction_set"},
    "cards": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/card"}
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "card": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "language", "palette", "logline", "feel", "sound", "risk", "usesDepth", "skeleton"],
      "properties": {
        "key": {"enum": ["fit", "amplify", "unexpected"]},
        "language": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
        "palette": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {"type": "object", "additionalProperties": false, "required": ["color", "role", "source"],
            "properties": {"color": {"$ref": "#/$defs/color"}, "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}, "source": {"type": "string", "minLength": 1, "maxLength": 120}}}
        },
        "logline": {"type": "string", "minLength": 1, "maxLength": 300},
        "feel": {
          "type": "object", "additionalProperties": false, "required": ["route", "bpm", "eventsPerBar"],
          "properties": {
            "route": {"enum": ["continuous", "montage", "hybrid"]},
            "bpm": {"type": "integer", "minimum": 60, "maximum": 180},
            "eventsPerBar": {"type": "number", "minimum": 0, "maximum": 16}
          }
        },
        "sound": {"type": "string", "minLength": 1, "maxLength": 300},
        "risk": {"type": "string", "minLength": 1, "maxLength": 300},
        "usesDepth": {"type": "boolean"},
        "skeleton": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": {"type": "object", "additionalProperties": false, "required": ["purpose", "approach"],
            "properties": {
              "purpose": {"type": "string", "minLength": 1, "maxLength": 200},
              "approach": {"type": "string", "pattern": "^(block:[a-z][a-z0-9-]{0,47}|custom)$"},
              "keyText": {"type": "string", "maxLength": 200}
            }}
        }
      }
    }
  }
}
