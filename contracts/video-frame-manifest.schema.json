{
 "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://promobento.com/contracts/video-frame-manifest/3.0.0",
 "title":"Authorized video frame manifest", "type":"object", "additionalProperties":false,
 "required":["schemaVersion","kind","source","browserVersion","width","height","poster","packs","frames"],
 "properties":{
  "schemaVersion":{"const":"3.0.0"}, "kind":{"const":"video_frame_manifest"},
  "source":{"type":"object","additionalProperties":false,"required":["sha256","byteLength","mediaType"],"properties":{
   "sha256":{"$ref":"#/$defs/sha256"},"byteLength":{"type":"integer","minimum":1,"maximum":52428800},"mediaType":{"enum":["video/mp4","video/quicktime","video/webm","image/gif"]}}},
  "browserVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$","maxLength":40},
  "width":{"type":"integer","minimum":1,"maximum":4096},"height":{"type":"integer","minimum":1,"maximum":4096},
  "poster":{"$ref":"#/$defs/poster"},"packs":{"type":"array","minItems":1,"maxItems":180,"items":{"$ref":"#/$defs/pack"}},
  "frames":{"type":"array","minItems":1,"maxItems":1800,"items":{"type":"object","additionalProperties":false,"required":["index","pts","duration","pack","offset","byteLength"],"properties":{
   "index":{"type":"integer","minimum":0,"maximum":1799},"pts":{"type":"number","minimum":0,"maximum":60},"duration":{"type":"number","exclusiveMinimum":0,"maximum":1},
   "pack":{"type":"integer","minimum":0,"maximum":179},"offset":{"type":"integer","minimum":0,"maximum":12582912},"byteLength":{"type":"integer","minimum":1,"maximum":12582912}}}}
 },
 "$defs":{
  "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "poster":{"type":"object","additionalProperties":false,"required":["sha256","byteLength"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"byteLength":{"type":"integer","minimum":1,"maximum":1048576}}},
  "pack":{"type":"object","additionalProperties":false,"required":["sha256","byteLength"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"byteLength":{"type":"integer","minimum":1,"maximum":12582912}}}
 }
}
