{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://promobento.com/contracts/creative-audio-tools.schema.json",
  "type":"object","additionalProperties":false,
  "required":["operation","script","scriptConfirmed","durationSeconds","speechSpans","spanBasis"],
  "properties":{
    "operation":{"const":"captions"},
    "script":{"type":"string","minLength":1,"maxLength":2000},
    "scriptConfirmed":{"const":true},
    "durationSeconds":{"type":"number","exclusiveMinimum":0,"maximum":30},
    "spanBasis":{"enum":["human_confirmed","measured_pcm_energy_reviewed"]},
    "speechSpans":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0,"maximum":30}}},
    "maxLineUnits":{"type":"integer","minimum":4,"maximum":40},
    "keepTerms":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":64}},
    "characterAnchors":{"type":"array","minItems":1,"maxItems":2000,"items":{
      "type":"object","additionalProperties":false,"required":["ch","start","end"],
      "properties":{"ch":{"type":"string","minLength":1,"maxLength":2},"start":{"type":"number","minimum":0,"maximum":30},"end":{"type":"number","minimum":0,"maximum":30}}
    }}
  }
}
