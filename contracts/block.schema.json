{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/block/3.0.0",
  "title": "Scene block manifest",
  "description": "Declared by each trusted block in packages/blocks. The block's params Schema validates FilmSpec scene params for that block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "version", "category", "aspects", "params", "editable", "cost", "events", "regions", "usesGsap", "usesWebgl", "goldenFrames"],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "kind": {"const": "block_manifest"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"},
    "category": {"enum": ["opening", "software", "data", "course", "3d", "closing", "transition"]},
    "aspects": {
      "description": "Every block lays out all four aspects; a block that cannot is not shipped.",
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["landscape", "portrait", "feed", "square"]}
    },
    "params": {
      "description": "A JSON Schema object for this block's FilmSpec scene params.",
      "type": "object", "required": ["type"],
      "properties": {"type": {"const": "object"}}
    },
    "editable": {
      "description": "Param paths exposed as Studio editables.",
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"}
    },
    "cost": {"enum": ["low", "medium", "high", "webgl"]},
    "events": {
      "description": "Named moments the block emits, used for automatic sound effects.",
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "description"],
        "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "regions": {
      "description": "Clickable region ids the block declares; text slots are always regions.",
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}
    },
    "usesGsap": {"type": "boolean"},
    "usesWebgl": {"type": "boolean"},
    "goldenFrames": {
      "description": "Frames rendered in every aspect for regression, with in-order, out-of-order and cold seeks.",
      "type": "array", "minItems": 3, "maxItems": 12, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 900}
    }
  }
}
