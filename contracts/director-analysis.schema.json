{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promobento.com/contracts/director-analysis/3.0.0",
  "title": "S1 confirmed fact organization",
  "$defs": {
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "factIds",
        "summary"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "kind": {
          "const": "fact_analysis"
        },
        "factIds": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "$ref": "#/$defs/facts"
}
